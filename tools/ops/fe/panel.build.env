# Build-time variables of kiva-backoffice-fe (tools/ops/deploy-fe.ps1 -App panel). NEXT_PUBLIC_* end up in the
# browser's JavaScript, so nothing secret ever goes here. One NAME=value per line.
NEXT_PUBLIC_API_URL=https://api.kivashop.ir/api/v1/
# The shop, for the panel's «مشاهده در سایت» links (product, post, page)
NEXT_PUBLIC_STORE_URL=https://kivashop.ir
