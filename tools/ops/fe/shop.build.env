# Build-time variables of kiva-fe (tools/ops/deploy-fe.ps1 -App shop). NEXT_PUBLIC_* end up in the browser's
# JavaScript, so nothing secret ever goes here. One NAME=value per line. Add every NEXT_PUBLIC_* the shop reads
# (its .env.production or README says which) before the first deploy with this script.
NEXT_PUBLIC_API_URL=https://api.kivashop.ir/api/v1/
