# /opt/kiva/conf/kiva.env on the server (root, 600), read by systemd for kiva.service. LAUNCH.md, step 6.6.
# This copy has no secret in it and never will: every <SECRET> line is written on the server with
#   /opt/kiva-ops/set-env.sh --secret NAME
# which reads the value without showing it. The rest with /opt/kiva-ops/set-env.sh NAME (shown while typed).
# The launch check (tools/ops/launch-check.sh) compares the live file with what this one says.

# --- database ---
KIVA_DB_URL=jdbc:postgresql://localhost:5432/kiva
KIVA_DB_USER=kiva
KIVA_DB_PASSWORD=<SECRET>

# --- login: two different `openssl rand -base64 32`, made on the server ---
KIVA_OTP_PEPPER=<SECRET>
KIVA_JWT_SECRET=<SECRET>

# --- behind nginx and ArvanCloud ---
KIVA_TRUSTED_PROXY_HOPS=1
# The shop, www and the panel; no localhost on the server (step 6.5). Same list as $kiva_cors_origin in kiva-http.conf.
KIVA_ALLOWED_ORIGINS=https://kivashop.ir,https://www.kivashop.ir,https://admin.kivashop.ir
KIVA_SITE_URL=https://kivashop.ir
KIVA_API_PUBLIC_URL=https://api.kivashop.ir

# --- payment (step 6.6): Zarinpal, real money ---
KIVA_PAYMENT_PROVIDER=zarinpal
KIVA_ZARINPAL_SANDBOX=false
KIVA_ZARINPAL_MERCHANT_ID=<SECRET>
KIVA_PAYMENT_RESULT_URL=https://kivashop.ir/checkout/result

# --- Email (phase 13): "log" until a provider is chosen; then smtp with its host, sender and login ---
KIVA_EMAIL_PROVIDER=log
# KIVA_EMAIL_PROVIDER=smtp
# KIVA_SMTP_HOST=<smtp host>
# KIVA_SMTP_PORT=587
# KIVA_SMTP_USERNAME=<login>
# KIVA_SMTP_PASSWORD=<SECRET>
# KIVA_SMTP_FROM=noreply@kivashop.ir

# --- SMS (step 6.6): every pattern approved in the Faraz panel; a missing one is a WARN at startup ---
KIVA_SMS_PROVIDER=faraz
KIVA_FARAZ_API_KEY=<SECRET>
KIVA_FARAZ_LINE_NUMBER=90008361
KIVA_FARAZ_CODE_PATTERN=<pattern code>
KIVA_FARAZ_PHONE_CHANGED_PATTERN=<pattern code>
KIVA_FARAZ_ORDER_PAID_PATTERN=<pattern code>
KIVA_FARAZ_PHOTOS_SENT_PATTERN=<pattern code>
KIVA_FARAZ_ORDER_SHIPPED_PATTERN=<pattern code>
KIVA_FARAZ_ORDER_DELIVERED_PATTERN=<pattern code>
KIVA_FARAZ_ORDER_CANCELLED_PATTERN=<pattern code>
KIVA_FARAZ_REFUND_COMPLETED_PATTERN=<pattern code>
KIVA_FARAZ_CHANGE_RESOLVED_PATTERN=<pattern code>
KIVA_FARAZ_RETURN_APPROVED_PATTERN=<pattern code>
KIVA_FARAZ_RETURN_REJECTED_PATTERN=<pattern code>
KIVA_FARAZ_RETURN_PICKUP_PATTERN=<pattern code>
KIVA_FARAZ_RETURN_CLOSED_PATTERN=<pattern code>
KIVA_FARAZ_BACK_IN_STOCK_PATTERN=<pattern code>
KIVA_FARAZ_CONTACT_REPLIED_PATTERN=<pattern code>
# Not read by the app: tools/ops/alerts.sh sends the owner's alerts with it (step 6.8). Its variable is `what`.
KIVA_FARAZ_ALERT_PATTERN=<pattern code>
KIVA_ALERT_PHONE=<the owner's mobile, 09xxxxxxxxx>

# --- media (step 6.2) ---
KIVA_MEDIA_ROOT=/var/lib/kiva/media
KIVA_MEDIA_PUBLIC_URL=https://api.kivashop.ir/media
KIVA_MEDIA_SERVE_LOCALLY=false

# --- jobs on, seed off (step 6.7) ---
KIVA_JOBS_ENABLED=true
KIVA_SEED_ENABLED=false

# --- only for the very first start (step 6.1), then the line is removed ---
# KIVA_BOOTSTRAP_ADMIN_PHONE=09xxxxxxxxx
